# Standalone Zitadel deployment, written by deploy.py
# The ZITADEL_* values not listed here are derived from EOS_AUTH_ISSUER
EOS_AUTH_ISSUER=https://localhost
# TLS: internal (self-signed) | custom (mounted cert) | acme (Let's Encrypt) | none (plain HTTP)
ZITADEL_TLS_MODE=internal
# Exactly 32 characters
ZITADEL_MASTERKEY=
ZITADEL_DB_PASSWORD=
ZITADEL_ADMIN_PASSWORD=
