COMPOSE_PROJECT_NAME=eos

EOS_POSTGRES_DB=eos
EOS_POSTGRES_HOST=localhost
EOS_POSTGRES_PORT=5432
EOS_POSTGRES_USER=
EOS_POSTGRES_PASSWORD=

EOS_S3_BUCKET=eos
EOS_S3_ENDPOINT_URL=http://localhost:8333
EOS_S3_ACCESS_KEY_ID=
EOS_S3_SECRET_ACCESS_KEY=

EOS_WEB_API_HOST=localhost
EOS_WEB_API_PORT=8070

# Authentication (Zitadel OIDC)
EOS_AUTH_ENABLED=false
EOS_AUTH_ISSUER=https://auth.example.org
EOS_AUTH_ORG_ID=
EOS_AUTH_PROJECT_ID=
EOS_AUTH_PAT=
EOS_AUTH_INTROSPECTION_CLIENT_ID=
EOS_AUTH_INTROSPECTION_CLIENT_SECRET=
# Trusts the issuer's TLS, e.g. docker/zitadel/caddy-root.crt
EOS_AUTH_CA_BUNDLE=

# Bundled Zitadel deployment; the other ZITADEL_* values are derived from EOS_AUTH_ISSUER
# TLS: internal (self-signed) | custom (mounted cert) | acme (Let's Encrypt) | none (plain HTTP)
ZITADEL_TLS_MODE=internal
# Exactly 32 characters
ZITADEL_MASTERKEY=
ZITADEL_DB_PASSWORD=
ZITADEL_ADMIN_PASSWORD=
